#include <iostream>
#include <vector>
#include <string>
#include <bits/stdc++.h>
 
using namespace std;
 
int main(void){
	int t,n;
	cin >> t;
	vector <int> arr;
	for(int i = 0;i<t;i++){
		cin >> n;
		int num1 = n/10;
		int num2 = n % 10;
		arr.push_back(num1+num2);
		
	}
	
	for(int i = 0;i<t;i++){
		cout << arr[i] << endl;
	}
}