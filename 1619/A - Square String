import math
size = int(input())
result = [] * size
for x in range(size):
    string = input()
    length = math.ceil(len(string) / 2 )
    if len(string) % 2 != 0:
        result.append("NO")
    else:
        first = string[:length:1]
        second = string[length::1]
        if first == second:
            result.append("YES")
        else:
            result.append("NO")
for x in range(size):
    print(result[x])