#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin >> t;
    int a,b,c;
    vector <string> result;
    for(int i = 0 ;i<t;i++){
        cin >> a >> b >> c;
        if(b > a && b < c){
            result.push_back("STAIR");
        }
        else if(b > a && b > c){
            result.push_back("PEAK");
        }
        else{
            result.push_back("NONE");
        }
    }
    for(int i = 0;i<t;i++){
        cout << result[i] << endl;
    }
 
}