t = int(input())
result=[]
for x in range(t):
    num = list(map(int, input()))
    sum1 = 0
    sum2=0
    sum1+=num[0] + num[1] + num[2]
    sum2+=num[3] + num[4] + num[5]
    if sum1 == sum2 :
        result.append("YES")
    else:
        result.append("NO")
 
for x in range(t):
    print(result[x])